# Copy to .env (cp .env.example .env) and fill in the values marked as REQUIRED.
# .env is git-ignored; never commit real credentials.

# --- AccuWeather (REQUIRED) ----------------------------------------------------------------------
# Get a key at https://developer.accuweather.com
ACCUWEATHER_API_KEY=your_accuweather_api_key
# ACCUWEATHER_BASE_URL=https://dataservice.accuweather.com

# --- Historical Snowflake exports (optional) ----------------------------------------------------
# Folder containing historical_condition_raw_data.csv and historical_condition_raw_data_clone.csv.
# Loaded once by the bootstrap run; leave the default (an empty folder) to start without history.
HISTORICAL_DATA_DIR=./data/historical

# --- Pipeline -----------------------------------------------------------------------------------
# Daily refresh (cron + time zone). 08:30 UTC is after local midnight for UTC-3 ... UTC-8 cities.
# PIPELINE_SCHEDULE_CRON=30 8 * * *
# PIPELINE_SCHEDULE_TIMEZONE=UTC
# Run the idempotent bootstrap job on every `docker compose up -d`.
# BOOTSTRAP_ON_STARTUP=true

# --- PostgreSQL (REQUIRED: choose strong passwords, letters and digits) ---------------------------
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser
WAREHOUSE_PASSWORD=change_me_etl
BI_READER_PASSWORD=change_me_bi_reader
DAGSTER_PG_PASSWORD=change_me_dagster
SUPERSET_PG_PASSWORD=change_me_superset
# WAREHOUSE_DB=weather
# WAREHOUSE_USER=etl
# BI_READER_USER=bi_reader

# --- MinIO (REQUIRED) ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
# MINIO_BUCKET=accuweather-raw

# --- Superset (REQUIRED) ------------------------------------------------------------------------
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_me_admin
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPERSET_SECRET_KEY=change_me_to_a_long_random_string
# Re-import the bundled dashboards on start, overwriting changes made in the UI.
# SUPERSET_FORCE_REIMPORT=false
# Optional: only needed for Mapbox base maps (OpenStreetMap/CARTO maps work without it).
# MAPBOX_API_KEY=

# --- Host ports (change them if they are already in use) ------------------------------------------
# HOST_BIND_IP=127.0.0.1
# DAGSTER_PORT=3001
# SUPERSET_PORT=8089
# MINIO_API_PORT=9010
# MINIO_CONSOLE_PORT=9011
# POSTGRES_PORT=5435
